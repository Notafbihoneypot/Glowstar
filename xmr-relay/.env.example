# Long random secret shared only by Commerce and the loopback relay-gate/notifier services.
GLOWSTR_COMMERCE_ADMIN_TOKEN=replace-with-at-least-32-random-bytes

# monero-wallet-rpc stays on host loopback.
MONERO_WALLET_RPC=http://127.0.0.1:18083/json_rpc
MONERO_RPC_USER=glowstr
MONERO_RPC_PASS=replace-me

GLOWSTR_ALLOWED_ORIGIN=https://glowstr.com
GLOWSTR_XMR_CONFIRMATIONS=2
GLOWSTR_RELAY_TARGET=relay.glowstr.com

# Multi-AUTH paid write gate. Armada Concord can authenticate the real user plus
# derived stream keys on one WebSocket. Ordinary events keep author matching;
# encrypted privacy wrappers (1059/21059) get only the narrow mismatch exception.
GLOWSTR_ENTITLEMENT_CACHE_SECONDS=15
GLOWSTR_GATE_MAX_AUTH_KEYS=64
GLOWSTR_ALLOW_PRIVACY_WRAPPERS=true

# Annual relay membership: $10 USD equivalent in XMR, price locked per invoice.
GLOWSTR_RELAY_USD_CENTS=1000
GLOWSTR_XMR_USD_URL=https://api.kraken.com/0/public/Ticker?pair=XMRUSD
# Optional fixed XMR/USD price for testing/offline staging only.
GLOWSTR_XMR_USD_OVERRIDE=

# Invoice/payment reconciliation.
GLOWSTR_INVOICE_SECONDS=1800
GLOWSTR_LATE_PAYMENT_GRACE_SECONDS=300
GLOWSTR_RECONCILE_SECONDS=20

# NIP-17 annual-renewal notifications.
# Generate a DEDICATED Nostr service key and put only the raw 64-hex secret
# in this local file. Never commit the file or use a personal nsec.
GLOWSTR_NIP17_SECRET_PATH=./secrets/notifier.key

# Public hex pubkey derived from the notifier secret above. Commerce exposes only
# this public value so Glowstr can distinguish official renewal DMs from lookalikes.
GLOWSTR_NIP17_PUBLIC_KEY=replace-with-64-hex-notifier-pubkey

# Public relays used only to discover users' kind:10050 DM inbox lists.
GLOWSTR_NIP17_LOOKUP_RELAYS=wss://nos.lol,wss://relay.nostr.band

# Server-side allowlist for recipient-controlled kind:10050 inbox URLs.
# Add hosts here before the notifier is allowed to connect to them.
GLOWSTR_NIP17_ALLOWED_RELAY_HOSTS=nos.lol,relay.nostr.band

# Optional: publish the sender-addressed NIP-17 copy to the service account's
# own DM inbox relays. If empty, an encrypted sender copy stays in the notifier volume.
GLOWSTR_NIP17_SENDER_RELAYS=

GLOWSTR_NIP17_POLL_SECONDS=300
GLOWSTR_NIP17_RETRY_SECONDS=21600
GLOWSTR_NIP17_BATCH_SIZE=25
