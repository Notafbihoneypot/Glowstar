FROM python:3.13-alpine
# Monero wallet-RPC requires HTTP Digest auth; requests handles its challenge
# reliably where Python 3.13 urllib repeatedly returns HTTP 401.
RUN pip install --no-cache-dir --disable-pip-version-check 'requests==2.32.5'
RUN addgroup -S glowstr && adduser -S -G glowstr glowstr
WORKDIR /app
COPY server.py /app/server.py
RUN mkdir -p /data && chown -R glowstr:glowstr /data /app
USER glowstr
ENV GLOWSTR_COMMERCE_HOST=0.0.0.0 GLOWSTR_COMMERCE_PORT=8787 GLOWSTR_COMMERCE_DB=/data/commerce.sqlite3
EXPOSE 8787
ENV PYTHONUNBUFFERED=1
CMD ["python3","-u","/app/server.py"]
