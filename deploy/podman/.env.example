# Public DNS names. Both must resolve to this server before Caddy requests TLS.
APP_DOMAIN=glowstr.com
RELAY_DOMAIN=relay.glowstr.com
# Start with --stagenet for a no-real-money end-to-end test.
MONERO_NETWORK=mainnet
MONERO_NETWORK_FLAG=
MONERO_WALLET_NAME=glowstr-mainnet

# Monero CLI v0.18.5.1, verified against the official release hash.
MONERO_VERSION=0.18.5.1
MONERO_ARCH=x64
MONERO_ARCHIVE=monero-linux-x64-v0.18.5.1.tar.bz2
MONERO_SHA256=22a7dda7b0cb699fdd6b7674c3b4a4465b337cc98a54983523b759e1e7cc9958

GLOWSTR_XMR_CONFIRMATIONS=2

# Crosspost identity hub. Use one or more comma-separated 64-character hex Nostr pubkeys.
CROSSPOST_ALLOWED_PUBKEYS=
CROSSPOST_PREVIEW_ONLY=true
CROSSPOST_X_CLIENT_ID=
CROSSPOST_MASTODON_HOSTS=mastodon.social,fosstodon.org,hachyderm.io
CROSSPOST_ACTIVITYPUB_HOSTS=
CROSSPOST_BLUESKY_HOSTS=bsky.social
CROSSPOST_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
CROSSPOST_DAILY_LIMIT=50

# Starter price: 0.02 XMR for 30 days. Atomic units; edit before production if desired.
GLOWSTR_XMR_CROSSPOST_30D_ATOMIC=20000000000
GLOWSTR_XMR_MAX_PENDING_PER_PUBKEY=5
GLOWSTR_XMR_MAX_INVOICES_PER_HOUR=500
