CROSSPOST_PUBLIC_URL=http://localhost:8790
CROSSPOST_ALLOWED_PUBKEYS=replace_with_your_64_character_hex_nostr_public_key
CROSSPOST_PREVIEW_ONLY=true
CROSSPOST_MASTODON_HOSTS=mastodon.social,fosstodon.org,hachyderm.io
# Add your own approved server, after confirming its Mastodon API compatibility.
CROSSPOST_ACTIVITYPUB_HOSTS=
CROSSPOST_BLUESKY_HOSTS=bsky.social
# X OAuth 2 application. Set the callback URL to CROSSPOST_PUBLIC_URL/oauth/x/callback.
CROSSPOST_X_CLIENT_ID=
# Optional for confidential X web apps; prefer the file form in production.
# CROSSPOST_X_CLIENT_SECRET_FILE=./secrets/x_client_secret
CROSSPOST_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
CROSSPOST_DAILY_LIMIT=50
CROSSPOST_ENCRYPTION_KEY_FILE=./secrets/encryption_key
CROSSPOST_DATA=./data
# Optional existing Monero Commerce service. Empty disables membership checks.
CROSSPOST_COMMERCE_URL=
CROSSPOST_ENTITLEMENT_FEATURE=relay_30d
CROSSPOST_ENTITLEMENT_TARGET=
