# Public DNS names. Both must resolve to this server before Caddy requests TLS.
APP_DOMAIN=glowstr.com
RELAY_DOMAIN=relay.glowstr.com
# Start with --stagenet for a no-real-money end-to-end test.
MONERO_NETWORK=mainnet
MONERO_NETWORK_FLAG=
MONERO_WALLET_NAME=glowstr-mainnet

# Monero CLI v0.18.5.1, verified against the official release hash.
MONERO_VERSION=0.18.5.1
MONERO_ARCH=x64
MONERO_ARCHIVE=monero-linux-x64-v0.18.5.1.tar.bz2
MONERO_SHA256=22a7dda7b0cb699fdd6b7674c3b4a4465b337cc98a54983523b759e1e7cc9958

GLOWSTR_XMR_CONFIRMATIONS=2
