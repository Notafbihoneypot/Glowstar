# Long random secret shared only by the commerce service and relay policy plugin.
GLOWSTR_COMMERCE_ADMIN_TOKEN=replace-with-at-least-32-random-bytes

# monero-wallet-rpc should stay on loopback/private networking and use --rpc-login.
MONERO_WALLET_RPC=http://host.containers.internal:18083/json_rpc
MONERO_RPC_USER=glowstr
MONERO_RPC_PASS=replace-me

GLOWSTR_ALLOWED_ORIGIN=https://glowstr.com
GLOWSTR_XMR_CONFIRMATIONS=2
GLOWSTR_RELAY_TARGET=relay.glowstr.com
