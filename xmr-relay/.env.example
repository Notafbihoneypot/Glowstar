# Long random secret shared only by the commerce service and relay policy plugin.
GLOWSTR_COMMERCE_ADMIN_TOKEN=replace-with-at-least-32-random-bytes

# monero-wallet-rpc stays on host loopback.
MONERO_WALLET_RPC=http://127.0.0.1:18083/json_rpc
MONERO_RPC_USER=glowstr
MONERO_RPC_PASS=replace-me

GLOWSTR_ALLOWED_ORIGIN=https://glowstr.com
GLOWSTR_XMR_CONFIRMATIONS=2
GLOWSTR_RELAY_TARGET=relay.glowstr.com

# Annual relay membership: $10 USD equivalent in XMR, price locked per invoice.
GLOWSTR_RELAY_USD_CENTS=1000
GLOWSTR_XMR_USD_URL=https://api.kraken.com/0/public/Ticker?pair=XMRUSD
# Optional fixed XMR/USD price for testing/offline staging only.
GLOWSTR_XMR_USD_OVERRIDE=

# Invoice/payment reconciliation.
GLOWSTR_INVOICE_SECONDS=1800
GLOWSTR_LATE_PAYMENT_GRACE_SECONDS=300
GLOWSTR_RECONCILE_SECONDS=20
