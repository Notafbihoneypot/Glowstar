FROM node:22-alpine

WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

COPY notifier.mjs keygen.mjs ./

RUN mkdir -p /data && chown -R node:node /app /data
USER node

ENV NODE_ENV=production
CMD ["node", "notifier.mjs"]
